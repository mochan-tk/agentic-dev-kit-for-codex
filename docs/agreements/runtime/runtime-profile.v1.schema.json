{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mochan-tk/agentic-dev-kit-for-codex/blob/main/docs/agreements/runtime/runtime-profile.v1.schema.json",
  "title": "runtime-profile/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "repository", "observed_at", "scope", "status", "reason", "platform", "client", "capabilities", "auth", "request", "shell_environment", "evidence", "live_run_allowed"],
  "properties": {
    "schema": {"const": "runtime-profile/v1"},
    "repository": {"const": "mochan-tk/agentic-dev-kit-for-codex"},
    "observed_at": {"type": "string", "format": "date-time"},
    "scope": {"enum": ["task-start-sensor", "exact-head-live-sensor", "fixture"]},
    "status": {"enum": ["match", "profile-drift", "unsupported-client", "UNKNOWN", "UNCHECKABLE"]},
    "reason": {"type": "string", "minLength": 1, "maxLength": 256},
    "platform": {
      "type": "object", "additionalProperties": false,
      "required": ["os", "architecture"],
      "properties": {"os": {"type": "string", "minLength": 1}, "architecture": {"type": "string", "minLength": 1}}
    },
    "client": {
      "type": "object", "additionalProperties": false,
      "required": ["version_output", "release_class", "binary_sha256", "exec_help_sha256", "resolved_path_recorded"],
      "properties": {
        "version_output": {"type": "string", "minLength": 1, "maxLength": 128},
        "release_class": {"enum": ["stable", "prerelease-alpha", "prerelease-beta", "prerelease-rc", "unknown"]},
        "binary_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "exec_help_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "resolved_path_recorded": {"const": false}
      }
    },
    "capabilities": {
      "type": "object", "additionalProperties": false,
      "required": ["exec_json", "ephemeral", "strict_config", "ignore_user_config", "workspace_write", "approval_never", "documented_config_keys_probe", "shell_environment_probe", "process_containment_probe", "model", "reasoning", "sandbox", "approval", "overrides"],
      "properties": {
        "exec_json": {"type": "boolean"}, "ephemeral": {"type": "boolean"}, "strict_config": {"type": "boolean"},
        "ignore_user_config": {"type": "boolean"}, "workspace_write": {"type": "boolean"}, "approval_never": {"type": "boolean"},
        "documented_config_keys_probe": {"enum": ["pass", "fail", "not-proven", "UNCHECKABLE"]},
        "shell_environment_probe": {"enum": ["pass", "fail", "not-run", "UNCHECKABLE"]},
        "process_containment_probe": {"enum": ["pass", "fail", "not-run", "UNCHECKABLE"]},
        "model": {"type": "boolean"}, "reasoning": {"type": "boolean"}, "sandbox": {"type": "boolean"},
        "approval": {"type": "boolean"}, "overrides": {"type": "boolean"}
      }
    },
    "auth": {
      "type": "object", "additionalProperties": false,
      "required": ["class", "credential_values_recorded"],
      "properties": {"class": {"enum": ["signed-in-client", "api-key", "unavailable", "unknown"]}, "credential_values_recorded": {"const": false}}
    },
    "request": {
      "type": "object", "additionalProperties": false,
      "required": ["model", "reasoning_effort", "sandbox", "approval_policy", "config_profile"],
      "properties": {
        "model": {"type": "string", "minLength": 1, "maxLength": 64}, "reasoning_effort": {"enum": ["low", "medium", "high", "xhigh"]},
        "sandbox": {"const": "workspace-write"}, "approval_policy": {"const": "never"}, "config_profile": {"const": "t11-live-v1"}
      }
    },
    "shell_environment": {
      "type": "object", "additionalProperties": false,
      "required": ["inherit", "required_names", "path_policy", "fixed_values", "private_home", "private_tmpdir", "secret_named_variables_excluded", "probe_required"],
      "properties": {
        "inherit": {"const": "none"},
        "required_names": {"const": ["PATH", "HOME", "CODEX_HOME", "TMPDIR", "LANG", "LC_ALL", "TZ", "PYTHONHASHSEED", "GIT_CONFIG_NOSYSTEM", "GIT_TERMINAL_PROMPT", "GIT_OPTIONAL_LOCKS"]},
        "path_policy": {"const": "verified-executable-parent+verified-python-parent+/usr/bin+/bin-deduplicated"},
        "fixed_values": {
          "const": {"LANG": "C.UTF-8", "LC_ALL": "C.UTF-8", "TZ": "UTC", "PYTHONHASHSEED": "0", "GIT_CONFIG_NOSYSTEM": "1", "GIT_TERMINAL_PROMPT": "0", "GIT_OPTIONAL_LOCKS": "0"}
        },
        "private_home": {"const": true}, "private_tmpdir": {"const": true}, "secret_named_variables_excluded": {"const": true}, "probe_required": {"const": true}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["configuration_intent", "diagnostic_health", "exact_worker_argv", "network_sandbox_behavior"],
      "properties": {
        "configuration_intent": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema", "authority", "effective_configuration_proven", "configuration_sha256", "rules_profile_sha256", "dynamic_environment_values_excluded"],
          "properties": {
            "schema": {"const": "t11-runtime-configuration-intent/v1"},
            "authority": {"const": "adapter-authored"},
            "effective_configuration_proven": {"const": false},
            "configuration_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "rules_profile_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "dynamic_environment_values_excluded": {"const": ["CODEX_HOME", "HOME", "PATH", "TMPDIR"]}
          }
        },
        "diagnostic_health": {
          "type": "object",
          "additionalProperties": false,
          "required": ["classification", "status", "codex_issued_effective_configuration_proof"],
          "properties": {
            "classification": {"const": "diagnostic-only"},
            "status": {"enum": ["pass", "warning", "fail", "not-run", "UNCHECKABLE"]},
            "codex_issued_effective_configuration_proof": {"const": false}
          }
        },
        "exact_worker_argv": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "rules_bypass_absent", "dynamic_task_data_stdin_only"],
          "properties": {
            "status": {"enum": ["pass", "fail", "not-run", "UNCHECKABLE"]},
            "rules_bypass_absent": {"type": "boolean"},
            "dynamic_task_data_stdin_only": {"type": "boolean"}
          },
          "allOf": [{
            "if": {"properties": {"status": {"const": "pass"}}, "required": ["status"]},
            "then": {"properties": {"rules_bypass_absent": {"const": true}, "dynamic_task_data_stdin_only": {"const": true}}},
            "else": {"properties": {"rules_bypass_absent": {"const": false}, "dynamic_task_data_stdin_only": {"const": false}}}
          }]
        },
        "network_sandbox_behavior": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {"status": {"enum": ["pass", "fail", "not-run", "UNCHECKABLE"]}}
        }
      }
    },
    "live_run_allowed": {"type": "boolean"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "match"}}, "required": ["status"]},
      "then": {
        "properties": {
          "client": {"properties": {"version_output": {"pattern": "^codex-cli [0-9]+\\.[0-9]+\\.[0-9]+$"}, "release_class": {"const": "stable"}}},
          "capabilities": {"properties": {"exec_json": {"const": true}, "ephemeral": {"const": true}, "strict_config": {"const": true}, "ignore_user_config": {"const": true}, "workspace_write": {"const": true}, "approval_never": {"const": true}, "documented_config_keys_probe": {"const": "pass"}, "shell_environment_probe": {"const": "pass"}, "process_containment_probe": {"const": "pass"}, "model": {"const": true}, "reasoning": {"const": true}, "sandbox": {"const": true}, "approval": {"const": true}, "overrides": {"const": true}}, "required": ["exec_json", "ephemeral", "strict_config", "ignore_user_config", "workspace_write", "approval_never", "documented_config_keys_probe", "shell_environment_probe", "process_containment_probe", "model", "reasoning", "sandbox", "approval", "overrides"]},
          "auth": {"properties": {"class": {"enum": ["signed-in-client", "api-key"]}}},
          "evidence": {
            "properties": {
              "diagnostic_health": {"properties": {"status": {"const": "pass"}}},
              "exact_worker_argv": {"properties": {"status": {"const": "pass"}}},
              "network_sandbox_behavior": {"properties": {"status": {"const": "pass"}}}
            }
          },
          "live_run_allowed": {"const": true}
        }
      }
    },
    {
      "if": {"properties": {"client": {"properties": {"release_class": {"enum": ["prerelease-alpha", "prerelease-beta", "prerelease-rc"]}}, "required": ["release_class"]}}, "required": ["client"]},
      "then": {"properties": {"status": {"const": "unsupported-client"}, "live_run_allowed": {"const": false}}}
    },
    {
      "if": {"properties": {"status": {"enum": ["profile-drift", "unsupported-client", "UNKNOWN", "UNCHECKABLE"]}}, "required": ["status"]},
      "then": {"properties": {"live_run_allowed": {"const": false}}}
    },
    {
      "if": {"properties": {"live_run_allowed": {"const": true}}, "required": ["live_run_allowed"]},
      "then": {"properties": {"status": {"const": "match"}}}
    }
  ]
}
